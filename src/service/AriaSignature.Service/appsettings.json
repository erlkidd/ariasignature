{
  "ConnectionStrings": {
    "AriaSignature": "Data Source=ariasignature.db"
  },
  "Api": {
    "Port": 5160
  },
  "SmartMonitoring": {
    "Cron": "0 0 * * * ?"
  },
  "OutboundSync": {
    "Cron": "0 0/30 * * * ?"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  }
}
