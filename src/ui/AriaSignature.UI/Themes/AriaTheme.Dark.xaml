<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AriaPrimaryColor">#4F8DFF</Color>
    <Color x:Key="AriaSurfaceColor">#1E1F26</Color>
    <Color x:Key="AriaForegroundColor">#F0F3FA</Color>
    <SolidColorBrush x:Key="AriaPrimaryBrush" Color="{StaticResource AriaPrimaryColor}" />
    <SolidColorBrush x:Key="AriaSurfaceBrush" Color="{StaticResource AriaSurfaceColor}" />
    <SolidColorBrush x:Key="AriaForegroundBrush" Color="{StaticResource AriaForegroundColor}" />
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource AriaSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AriaForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AriaForegroundBrush}" />
    </Style>
    <Style TargetType="Control">
        <Setter Property="Foreground" Value="{StaticResource AriaForegroundBrush}" />
    </Style>
</ResourceDictionary>
