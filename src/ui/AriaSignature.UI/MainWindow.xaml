<Window x:Class="AriaSignature.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        DataContext="{StaticResource MainViewModel}"
        Title="AriaSignature — Панель управления"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        Icon="Assets/icon.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="24"
            FontWeight="SemiBold"
            Text="AriaSignature — Панель управления" />

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button
                DockPanel.Dock="Right"
                MinWidth="120"
                Padding="10,4"
                Command="{Binding RefreshCommand}"
                Content="Обновить" />
        </DockPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Накопители">
                <Grid Margin="12">
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Disks}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="2*" />
                            <DataGridTextColumn Header="Серийный №" Binding="{Binding Serial}" Width="2*" />
                            <DataGridTextColumn Header="Интерфейс" Binding="{Binding Interface}" Width="*" />
                            <DataGridTextColumn Header="Здоровье (%)" Binding="{Binding HealthPercent}" Width="*" />
                            <DataGridTextColumn Header="Температура (C)" Binding="{Binding TemperatureCelsius}" Width="*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Архивация">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10" BorderBrush="#B8B8B8" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя задачи" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Источник (.1CD)" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Назначение" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Периодичность" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Хранить копий" Margin="0,0,8,4" />

                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Text="{Binding NewBackupName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Text="{Binding NewBackupSource, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" Text="{Binding NewBackupDestination, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,8,0" ItemsSource="{Binding SchedulePresets}" SelectedItem="{Binding SelectedSchedulePreset}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Margin="0,0,8,0" Text="{Binding NewBackupRetention, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="1" Grid.Column="5" Padding="14,4" Content="Создать" Command="{Binding CreateBackupCommand}" />
                        </Grid>
                    </Border>

                    <DataGrid
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding BackupJobs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя задачи" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*" />
                            <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="2*" />
                            <DataGridTextColumn Header="Назначение" Binding="{Binding Destination}" Width="2*" />
                            <DataGridTextColumn Header="Расписание (Cron)" Binding="{Binding ScheduleCron}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid
                        Grid.Row="4"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding BackupLogs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="Начало (UTC)" Binding="{Binding StartTimeUtc}" Width="2*" />
                            <DataGridTextColumn Header="Окончание (UTC)" Binding="{Binding EndTimeUtc}" Width="2*" />
                            <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Настройки">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Базовый URL API:" />
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Интервал SMART (сек):" />
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SmartIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,0,0" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="8,4">
            <TextBlock Text="{Binding OperationStatus}" />
        </Border>
    </Grid>
</Window>
