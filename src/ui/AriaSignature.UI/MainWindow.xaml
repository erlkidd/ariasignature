<Window x:Class="AriaSignature.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AriaSignature — панель управления"
        Height="820"
        Width="1320"
        MinHeight="640"
        MinWidth="960"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1F2A" BorderBrush="#2F3347" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="AriaSignature" Foreground="#EEF1FA" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Content="—" Width="44" Height="44" Click="MinimizeButton_Click" FontSize="14"
                            Background="Transparent" Foreground="#EEF1FA" BorderBrush="{x:Null}" />
                    <Button x:Name="MaxRestoreButton" Content="□" Width="44" Height="44" Click="MaxRestoreButton_Click" FontSize="12"
                            Background="Transparent" Foreground="#EEF1FA" BorderBrush="{x:Null}" />
                    <Button x:Name="CloseButton" Content="✕" Width="44" Height="44" Click="CloseButton_Click" FontSize="12"
                            Background="Transparent" Foreground="#EEF1FA" BorderBrush="{x:Null}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" />
            <Border x:Name="WebViewLoadingOverlay" Background="#1E1F2A" Panel.ZIndex="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16" Foreground="#6B9EFF" Background="#2F3347" BorderThickness="0" />
                    <TextBlock x:Name="LoadingOverlayMessage"
                               Text="Инициализация WebView2…"
                               Foreground="#EEF1FA"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock x:Name="LoadingOverlayHint"
                               Text="При первом запуске это может занять до минуты. Убедитесь, что установлен WebView2 Runtime."
                               Foreground="#9AA3B2"
                               FontSize="14"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
