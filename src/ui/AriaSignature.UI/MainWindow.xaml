<Window x:Class="AriaSignature.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        DataContext="{StaticResource MainViewModel}"
        Title="AriaSignature — Панель управления"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900">
    <Grid Margin="16">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AriaForegroundBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AriaPrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource AriaPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="24"
            FontWeight="SemiBold"
            Text="AriaSignature — Панель управления" />

        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
            <Border DockPanel.Dock="Left" Background="#1A2F6FED" CornerRadius="10" Padding="10,6" Margin="0,0,10,0">
                <TextBlock Text="{Binding DiskCount, StringFormat=Диски: {0}}" FontWeight="SemiBold" />
            </Border>
            <Border DockPanel.Dock="Left" Background="#1A2F6FED" CornerRadius="10" Padding="10,6" Margin="0,0,10,0">
                <TextBlock Text="{Binding BackupJobCount, StringFormat=Задачи: {0}}" FontWeight="SemiBold" />
            </Border>
            <Border DockPanel.Dock="Left" Background="#1A2F6FED" CornerRadius="10" Padding="10,6">
                <TextBlock Text="{Binding FailedBackupCount, StringFormat=Ошибки: {0}}" FontWeight="SemiBold" />
            </Border>
            <Button
                DockPanel.Dock="Right"
                MinWidth="140"
                Padding="10,4"
                Command="{Binding RefreshCommand}"
                Content="Обновить" />
        </DockPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Накопители">
                <Grid Margin="12">
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Disks}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="2*" />
                            <DataGridTextColumn Header="Серийный №" Binding="{Binding Serial}" Width="2*" />
                            <DataGridTextColumn Header="Интерфейс" Binding="{Binding Interface}" Width="*" />
                            <DataGridTextColumn Header="Всего (bytes)" Binding="{Binding SizeTotalBytes}" Width="*" />
                            <DataGridTextColumn Header="Свободно (bytes)" Binding="{Binding SizeFreeBytes}" Width="*" />
                            <DataGridTextColumn Header="Здоровье (%)" Binding="{Binding HealthPercent}" Width="*" />
                            <DataGridTextColumn Header="Температура (C)" Binding="{Binding TemperatureCelsius}" Width="*" />
                            <DataGridTextColumn Header="PowerOnHours" Binding="{Binding PowerOnHours}" Width="*" />
                            <DataGridTextColumn Header="PowerCycleCount" Binding="{Binding PowerCycleCount}" Width="*" />
                            <DataGridTextColumn Header="Reallocated" Binding="{Binding ReallocatedSectors}" Width="*" />
                            <DataGridTextColumn Header="Pending" Binding="{Binding PendingSectors}" Width="*" />
                            <DataGridTextColumn Header="Uncorrectable" Binding="{Binding UncorrectableErrors}" Width="*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Архивация">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10" BorderBrush="#B8B8B8" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя задачи" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceFieldLabel}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Назначение" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Тип" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Периодичность" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="Хранить копий" Margin="0,0,8,4" />

                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Text="{Binding NewBackupName, UpdateSourceTrigger=PropertyChanged}" />
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,2" Content="..." Click="OnPickSourceClicked" />
                                <TextBox Text="{Binding NewBackupSource, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SourceFieldHint}" />
                            </DockPanel>
                            <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,2" Content="..." Click="OnPickDestinationClicked" />
                                <TextBox Text="{Binding NewBackupDestination, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,8,0" ItemsSource="{Binding BackupTypes}" SelectedItem="{Binding NewBackupType}" />
                            <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,0,8,0" ItemsSource="{Binding SchedulePresets}" SelectedItem="{Binding SelectedSchedulePreset}" />
                            <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBox Margin="0,0,0,6" Text="{Binding NewBackupRetention, UpdateSourceTrigger=PropertyChanged}" ToolTip="Количество архивов для хранения" />
                                <TextBox Text="{Binding NewBackupCron, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cron для пользовательского расписания" />
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="6" Padding="14,4" Content="Создать" Command="{Binding CreateBackupCommand}" />
                        </Grid>
                    </Border>

                    <DataGrid
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="False"
                        ItemsSource="{Binding BackupJobs}"
                        SelectedItem="{Binding SelectedBackupJob}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя задачи" Binding="{Binding Name}" Width="2*" />
                            <DataGridComboBoxColumn Header="Тип" Width="*" SelectedItemBinding="{Binding Type}" ItemsSource="{Binding DataContext.BackupTypes, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <DataGridTextColumn Header="Источник" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Назначение" Binding="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Расписание (Cron)" Binding="{Binding ScheduleCron, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridCheckBoxColumn Header="Включена" Binding="{Binding IsEnabled}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0" Padding="12,4" Content="Сохранить" Command="{Binding SaveBackupCommand}" />
                        <Button Margin="0,0,8,0" Padding="12,4" Content="Вкл/Выкл" Command="{Binding ToggleBackupCommand}" />
                        <Button Margin="0,0,8,0" Padding="12,4" Content="Запустить" Command="{Binding RunBackupCommand}" />
                        <Button Padding="12,4" Content="Удалить" Command="{Binding DeleteBackupCommand}" />
                    </StackPanel>

                    <DataGrid
                        Grid.Row="4"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding BackupLogs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="Начало (UTC)" Binding="{Binding StartTimeUtc}" Width="2*" />
                            <DataGridTextColumn Header="Окончание (UTC)" Binding="{Binding EndTimeUtc}" Width="2*" />
                            <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Настройки">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Базовый URL API:" />
                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{Binding ApiBaseUrl}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Интервал SMART (сек):" />
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SmartIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Тема:" />
                    <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Автозапуск:" />
                    <DockPanel Grid.Row="6" Grid.Column="2" LastChildFill="False">
                        <CheckBox Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding LaunchAtStartup}" Content="Запускать при входе в Windows" />
                        <Button Padding="12,4" Content="Применить" Command="{Binding SaveSettingsCommand}" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,8,0,0" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10,6">
            <TextBlock Text="{Binding OperationStatus}" />
        </Border>
    </Grid>
</Window>
